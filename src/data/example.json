{
  "module": "example",
  "version": "1.0.0",
  "description": "Standard scaffolds, configuration templates, entry declarations, and reference implementations",
  "templates": {
    "build_gradle_kts": "plugins {\n    alias(libs.plugins.android.application) // or com.android.library\n    alias(libs.plugins.kotlin.android) apply false\n}\n\nandroid {\n    namespace = \"com.example.xposedmodule\"\n    compileSdk = 35\n\n    defaultConfig {\n        minSdk = 26\n        targetSdk = 35\n        versionCode = 1\n        versionName = \"1.0\"\n        consumerProguardFiles(\"proguard-rules.pro\")\n    }\n\n    buildTypes {\n        release {\n            isMinifyEnabled = true\n            proguardFiles(getDefaultProguardFile(\"proguard-android-optimize.txt\"), \"proguard-rules.pro\")\n        }\n    }\n    compileOptions {\n        sourceCompatibility = JavaVersion.VERSION_17\n        targetCompatibility = JavaVersion.VERSION_17\n    }\n}\n\ndependencies {\n    compileOnly(\"io.github.libxposed:api:102.0.0\")\n    // Optional helper kit\n    // implementation(\"io.github.libxposed:helper:1.0.0\")\n    // implementation(\"io.github.libxposed:helper-ktx:1.0.0\")\n}",
    "proguard_rules": "-dontwarn io.github.libxposed.annotation.**\n-adaptresourcefilecontents META-INF/xposed/java_init.list\n-keep,allowoptimization,allowobfuscation public class * extends io.github.libxposed.api.XposedModule {\n    public <init>();\n}",
    "manifest_xml": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\">\n    <application>\n        <meta-data\n            android:name=\"xposedmodule\"\n            android:value=\"true\" />\n        <meta-data\n            android:name=\"xposeddescription\"\n            android:value=\"Describe your module functionality here\" />\n        <meta-data\n            android:name=\"xposedminversion\"\n            android:value=\"102\" />\n        <meta-data\n            android:name=\"xposedscope\"\n            android:resource=\"@array/xposed_scope\" />\n    </application>\n</manifest>",
    "java_init_list": "com.example.xposedmodule.ModuleMain",
    "java_module_example": "package com.example.xposedmodule;\n\nimport android.util.Log;\nimport androidx.annotation.NonNull;\nimport io.github.libxposed.api.XposedModule;\nimport io.github.libxposed.api.XposedInterface.Invoker;\n\npublic class ModuleMain extends XposedModule {\n    private static final String TAG = \"ModuleMain\";\n\n    @Override\n    public void onPackageReady(@NonNull PackageReadyParam param) {\n        try {\n            Class<?> targetClass = Class.forName(\"com.target.app.MainActivity\", true, param.getClassLoader());\n            var targetMethod = targetClass.getDeclaredMethod(\"someMethod\", String.class);\n\n            hook(targetMethod).intercept(chain -> {\n                log(Log.INFO, TAG, \"Intercepted: \" + chain.getExecutable().getName());\n                String originalArg = (String) chain.getArg(0);\n                \n                // Modify arguments or execute original\n                Object result = chain.proceed();\n                \n                // Return result\n                return result;\n            });\n        } catch (Throwable t) {\n            log(Log.ERROR, TAG, \"Hook initialization failed\", t);\n        }\n    }\n}",
    "kotlin_module_example": "package com.example.xposedmodule\n\nimport android.util.Log\nimport io.github.libxposed.api.XposedModule\n\nclass ModuleMainKt : XposedModule() {\n    companion object {\n        const val TAG = \"ModuleMainKt\"\n    }\n\n    override fun onPackageReady(param: PackageReadyParam) {\n        if (!param.isFirstPackage) return\n\n        try {\n            val targetClass = Class.forName(\"com.target.app.MainActivity\", true, param.classLoader)\n            val targetMethod = targetClass.getDeclaredMethod(\"someMethod\", String::class.java)\n\n            hook(targetMethod).intercept { chain ->\n                log(Log.INFO, TAG, \"Intercepted from Kotlin: ${chain.executable.name}\")\n                chain.proceed()\n            }\n        } catch (t: Throwable) {\n            log(Log.ERROR, TAG, \"Hook failed\", t)\n        }\n    }\n}"
  },
