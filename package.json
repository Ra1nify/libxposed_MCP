{
  "name": "libxposed-mcp",
  "version": "1.0.0",
  "description": "Full-spectrum Model Context Protocol (MCP) server for LibXposed modern Android hooking framework",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "libxposed-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test_mcp.mjs",
    "test:deep": "node scripts/deep_recheck.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wrangler": "^4.156.1"
  },
  "license": "Apache-2.0"
}
